# Prestige 1.21 GUI Fixes Patch
# Apply with: git apply prestige-1.21-gui-fixes.patch

diff --git a/build.gradle b/build.gradle
index xxxxxxx..yyyyyyy 100644
--- a/build.gradle
+++ b/build.gradle
@@ -51,14 +51,7 @@ dependencies {
     // ClassTransform (net.lenni0451, customised build); engine/EnginePlugin uses it to apply the client's @CTransformer hooks.
     shade files('libs/classtransform-bundled.jar')

-    // imgui-java (binding + lwjgl3 backend + windows natives) — used by the legacy ClickGUI overlay.
-    // The new ClickGUI renders through the client's own shader pipeline (dev.zprestige.prestige.ui.NativeDrawList)
-    // and no longer depends on imgui-java. Keeping the dependency here only to satisfy existing shade rules.
-    // TODO: remove once all imgui references are gone from the source tree.
-    implementation "io.github.spair:imgui-java:1.92.7.1"
-    implementation "io.github.spair:imgui-java-lwjgl3:1.92.7.1"
-    runtimeOnly "org.lwjgl:lwjgl:3.3.3"
-    runtimeOnly "org.lwjgl:lwjgl-glfw:3.3.3"
+    // The ClickGUI no longer uses imgui-java: its natives are desktop-only (Windows/Linux x86_64, macOS) and its GL3
+    // backend needs GLFW, neither of which exists in PojavLauncher on Android. The GUI now renders through the
+    // client's own shader pipeline (see dev.zprestige.prestige.ui.NativeDrawList).

     // MSDF font atlas generator (compile-time only)
     implementation "com.github.caciomc:msdfgen:1.0.0"

