+++ b/src/main/java/dev/zprestige/prestige/client/Prestige.java
@@ -128,14 +128,14 @@ public class Prestige implements ModInitializer {
         // initialises the module list.
         Native.registerModules(this);

-        // The engine's gated callbacks (key, mouse, tick, render) return immediately until
-        // EngineState.markReady is called. If any initialisation step throws, we log it but
-        // continue so the mod at least loads (the GUI key will be no-op until markReady).
-        // TODO: make this fatal once the port is verified stable on 1.21.
-        try {
-            EngineState.markReady("Prestige.init finished, modules=" + ModuleManager.INSTANCE.getModules().size());
-        } catch (Throwable t) {
-            System.err.println("[Prestige] init failed: " + t);
-        }
+        // The engine's gated callbacks (key, mouse, tick, render) return immediately until
+        // EngineState.markReady is called. Any failure here is fatal — without markReady the
+        // ClassTransform hooks (including the menu key) stay gated and the GUI won't open.
+        EngineState.markReady("Prestige.init finished, modules=" + ModuleManager.INSTANCE.getModules().size());
     }

     @Override

